# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Development: Set local values matching your machine setup.
# Production:  Set secure values provided by our hosting provider or server.
# ==============================================================================

# Server port number (e.g., 3000, 8080)
PORT=

# API mount prefix for all routes. Start with "/" and do not add a trailing "/".
# The frontend's VITE_API_BASE_URL must include the same base path.
API_BASE_PATH=/KUBO_Resort/Management-System/v0.0.1

# Application runtime environment (development, production, test)
NODE_ENV=

# Serve the built frontend from frontend/dist in production. Set to false when
# the frontend is deployed separately (for example, on Vercel).
SERVE_FRONTEND=true/false

# Full connection string for your database
# This project uses Drizzle ORM get your DB here: https://orm.drizzle.team/
DB_URL=

# Allowed frontend origin URL for CORS requests (e.g., http://localhost:3000 or any other DNS)
FR_ORIGIN=

# Minimum required character length for user passwords
PASSWORD_LENGTH=

# Environment Variables for pgAdmin connection to database
DB_URL=postgresql://<username>:<password>@localhost:5432/<databasename>
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Secret used to sign JWTs (at least 32 characters in production)
JWT_SECRET=

# Token lifetime (e.g. 8h, 1d). Defaults to 8h when unset.
JWT_EXPIRES_IN=8h
