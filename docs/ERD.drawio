                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    ROLE {\n        INT role_id PK\n        VARCHAR role_name UK\n        VARCHAR description\n    }\n\n    EMPLOYEE {\n        INT employee_id PK\n        INT role_id FK\n        VARCHAR first_name\n        VARCHAR last_name\n        VARCHAR username UK\n        VARCHAR password_hash\n        ENUM status\n        DATETIME created_at\n        DATETIME updated_at\n    }\n\n    GUEST {\n        INT guest_id PK\n        VARCHAR first_name\n        VARCHAR last_name\n        VARCHAR email\n        VARCHAR phone\n        VARCHAR address_line_1\n        VARCHAR city\n        VARCHAR state_province\n        VARCHAR zip_postal_code\n        VARCHAR country\n        ENUM valid_id_type\n        VARCHAR id_number\n        DATETIME created_at\n        DATETIME updated_at\n    }\n\n    ROOM_TYPE {\n        INT room_type_id PK\n        VARCHAR type_name UK\n        INT capacity\n        DECIMAL price_per_night\n        VARCHAR description\n    }\n\n    ROOM {\n        INT room_id PK\n        INT room_type_id FK\n        VARCHAR room_number UK\n        ENUM status\n    }\n\n    RESERVATION {\n        INT reservation_id PK\n        VARCHAR reference_code UK\n        INT guest_id FK\n        INT employee_id FK\n        DECIMAL total_reservation_amount\n        ENUM status\n        ENUM booking_source\n        DATETIME cancelled_at\n        VARCHAR cancellation_reason\n        DATETIME reserved_at\n    }\n\n    RESERVED_ROOM {\n        INT reservation_id PK, FK\n        INT room_id PK, FK\n        DATE check_in_date\n        DATE check_out_date\n        TIME scheduled_check_in_time\n        TIME scheduled_check_out_time\n        DATETIME actual_check_in_datetime\n        DATETIME actual_check_out_datetime\n        BOOLEAN early_check_in_approved\n        DECIMAL price_at_booking\n        ENUM status\n    }\n\n    PAYMENT {\n        INT payment_id PK\n        INT reservation_id FK\n        INT employee_id FK\n        DECIMAL payment_amount\n        ENUM transaction_type\n        ENUM payment_type\n        ENUM payment_method\n        ENUM payment_status\n        DATETIME payment_date\n    }\n\n    ADDITIONAL_CHARGE {\n        INT charge_id PK\n        INT reservation_id FK\n        INT employee_id FK\n        ENUM charge_type\n        DECIMAL amount\n        VARCHAR description\n        DATETIME charge_date\n    }\n\n    AUDIT_LOG {\n        INT audit_id PK\n        INT employee_id FK\n        ENUM action\n        VARCHAR entity_type\n        INT entity_id\n        TEXT description\n        JSON old_values\n        JSON new_values\n        VARCHAR ip_address\n        DATETIME created_at\n    }\n\n    ROLE ||--o{ EMPLOYEE : assigns\n    ROOM_TYPE ||--o{ ROOM : contains\n    GUEST ||--o{ RESERVATION : makes\n    EMPLOYEE ||--o{ RESERVATION : creates\n    RESERVATION ||--|{ RESERVED_ROOM : includes\n    ROOM ||--o{ RESERVED_ROOM : assigned_to\n    RESERVATION ||--o{ PAYMENT : has\n    EMPLOYEE ||--o{ PAYMENT : processes\n    RESERVATION ||--o{ ADDITIONAL_CHARGE : has\n    EMPLOYEE ||--o{ ADDITIONAL_CHARGE : records\n    EMPLOYEE ||--o{ AUDIT_LOG : generates&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XRV0ET_hilYDtMSbRLYC-1">
