                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    ROLE {\n        INT role_id PK\n        VARCHAR role_name UK\n        VARCHAR description\n    }\n\n    EMPLOYEE {\n        INT employee_id PK\n        INT role_id FK\n        VARCHAR first_name\n        VARCHAR last_name\n        VARCHAR username UK\n        VARCHAR password_hash\n        ENUM status\n        DATETIME created_at\n        DATETIME updated_at\n    }\n\n    GUEST {\n        INT guest_id PK\n        VARCHAR first_name\n        VARCHAR last_name\n        VARCHAR email\n        VARCHAR phone\n        VARCHAR address_line_1\n        VARCHAR city\n        VARCHAR state_province\n        VARCHAR zip_postal_code\n        VARCHAR country\n        ENUM valid_id_type\n        VARCHAR id_number\n        DATETIME created_at\n        DATETIME updated_at\n    }\n\n    ROOM_TYPE {\n        INT room_type_id PK\n        VARCHAR type_name UK\n        INT capacity\n        DECIMAL price_per_night\n        VARCHAR description\n    }\n\n    ROOM {\n        INT room_id PK\n        INT room_type_id FK\n        VARCHAR room_number UK\n        ENUM status\n    }\n\n    RESERVATION {\n        INT reservation_id PK\n        VARCHAR reference_code UK\n        INT guest_id FK\n        INT employee_id FK\n        DECIMAL total_reservation_amount\n        ENUM status\n        ENUM booking_source\n        DATETIME cancelled_at\n        VARCHAR cancellation_reason\n        DATETIME reserved_at\n    }\n\n    RESERVED_ROOM {\n        INT reservation_id PK, FK\n        INT room_id PK, FK\n        DATE check_in_date\n        DATE check_out_date\n        TIME scheduled_check_in_time\n        TIME scheduled_check_out_time\n        DATETIME actual_check_in_datetime\n        DATETIME actual_check_out_datetime\n        BOOLEAN early_check_in_approved\n        DECIMAL price_at_booking\n        ENUM status\n    }\n\n    PAYMENT {\n        INT payment_id PK\n        INT reservation_id FK\n        INT employee_id FK\n        DECIMAL payment_amount\n        ENUM transaction_type\n        ENUM payment_type\n        ENUM payment_method\n        ENUM payment_status\n        DATETIME payment_date\n    }\n\n    ADDITIONAL_CHARGE {\n        INT charge_id PK\n        INT reservation_id FK\n        INT employee_id FK\n        INT catalog_id FK\n        INT request_id FK\n        ENUM charge_type\n        INT quantity\n        DECIMAL unit_amount\n        DECIMAL amount\n        VARCHAR description\n        DATETIME charge_date\n    }\n\n    ADDITIONAL_CHARGE_CATALOG {\n        INT catalog_id PK\n        ENUM charge_type\n        VARCHAR name UK\n        VARCHAR description\n        DECIMAL unit_price\n        BOOLEAN is_active\n        DATETIME created_at\n        DATETIME updated_at\n    }\n\n    ADDITIONAL_CHARGE_REQUEST {\n        INT request_id PK\n        INT reservation_id FK\n        INT requested_by FK\n        ENUM charge_type\n        VARCHAR description\n        INT quantity\n        DECIMAL proposed_unit_amount\n        ENUM status\n        INT reviewed_by FK\n        DECIMAL approved_unit_amount\n        VARCHAR review_reason\n        DATETIME created_at\n        DATETIME reviewed_at\n    }\n\n    AUDIT_LOG {\n        INT audit_id PK\n        INT employee_id FK\n        ENUM action\n        VARCHAR entity_type\n        INT entity_id\n        TEXT description\n        JSON old_values\n        JSON new_values\n        VARCHAR ip_address\n        DATETIME created_at\n    }\n\n    ROLE ||--o{ EMPLOYEE : \&quot;assigns\&quot;\n    ROOM_TYPE ||--o{ ROOM : \&quot;contains\&quot;\n    GUEST ||--o{ RESERVATION : \&quot;makes\&quot;\n    EMPLOYEE ||--o{ RESERVATION : \&quot;creates\&quot;\n    RESERVATION ||--|{ RESERVED_ROOM : \&quot;includes\&quot;\n    ROOM ||--o{ RESERVED_ROOM : \&quot;assigned_to\&quot;\n    RESERVATION ||--o{ PAYMENT : \&quot;has\&quot;\n    EMPLOYEE ||--o{ PAYMENT : \&quot;processes\&quot;\n    RESERVATION ||--o{ ADDITIONAL_CHARGE : \&quot;has\&quot;\n    EMPLOYEE ||--o{ ADDITIONAL_CHARGE : \&quot;records\&quot;\n    ADDITIONAL_CHARGE_CATALOG ||--o{ ADDITIONAL_CHARGE : \&quot;applied_as\&quot;\n    ADDITIONAL_CHARGE_REQUEST ||--o| ADDITIONAL_CHARGE : \&quot;billed_as\&quot;\n    RESERVATION ||--o{ ADDITIONAL_CHARGE_REQUEST : \&quot;has\&quot;\n    EMPLOYEE ||--o{ ADDITIONAL_CHARGE_REQUEST : \&quot;requests\&quot;\n    EMPLOYEE ||--o{ ADDITIONAL_CHARGE_REQUEST : \&quot;reviews\&quot;\n    EMPLOYEE ||--o{ AUDIT_LOG : \&quot;generates\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="CnllJAilpjFTys0ZFjGG-1">
