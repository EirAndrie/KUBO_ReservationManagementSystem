        <mxCell id="OU9yhpyxLkDoYNgLCTYR-132" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Rate and Pricing Management Flow" vertex="1">
