        <mxCell id="OU9yhpyxLkDoYNgLCTYR-229" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&amp;nbsp;Check-in and Check-out Flow" vertex="1">
